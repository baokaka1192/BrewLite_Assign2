# ---- Database (docker-compose) ----
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite

# ---- Backend ----
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite
DATABASE_URL_TEST=postgresql://brewlite:brewlite@localhost:5432/brewlite_test
JWT_SECRET=brewlite-dev-only-jwt-secret-change-me-32
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
# Google sign-in (POST /api/auth/google). Empty disables the endpoint (404). Use the same client ID as the frontend.
GOOGLE_CLIENT_ID=
# Enables PATCH /api/orders/:id/status when set. Empty or unset keeps it disabled (404). Use a long random value.
STAFF_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Google sign-in. Leave empty to hide the button. Must match the backend GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum VoucherType {
  PERCENT
  FIXED
}

model Voucher {
  id          String      @id @default(cuid())
  // Stored uppercase; the API normalizes voucherCode before lookup.
  code        String      @unique
  type        VoucherType
  value       Int
  minSubtotal Int         @default(0)
  // Caps a PERCENT discount only.
  maxDiscount Int?
  expiresAt   DateTime?
  active      Boolean     @default(true)
  usageLimit  Int?
  usedCount   Int         @default(0)
}

model Product {
  id          String  @id
  name        String
  description String
  category    String
  price       Int
  imageUrl    String
  stock       Int     @default(0)
  available   Boolean @default(true)
  version     Int     @default(0)
  sizes       Json
  toppings    Json
  orderItems  OrderItem[]
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
  loyaltyPoints Int    @default(0)
  orders       Order[]
}

model Order {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)
  total       Int
  note        String?
  discount    Int         @default(0)
  voucherCode String?
  // Loyalty points granted when the order became PAID; deducted again if the order is cancelled.
  pointsEarned Int        @default(0)
  version     Int         @default(0)
  // Idempotency-Key from POST /api/orders and a hash of the request body it was used with.
  idempotencyKey String?
  requestHash    String?
  createdAt   DateTime    @default(now())
  items       OrderItem[]
  payments    Payment[]

  @@unique([userId, idempotencyKey])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  size      String
  toppings  Json
  qty       Int
  lineTotal Int
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  idempotencyKey String   @unique
  amount         Int
  method         String
  // status: PROCESSING | SUCCESS | FAILED. A partial unique index allows only one PROCESSING row per order (see migration 20261024180000).
  status         String
  // Hash of {orderId, method, card last 4} used to detect Idempotency-Key reuse with another body.
  requestHash    String?
  // Why a FAILED payment failed; replayed in the 402 body for the same Idempotency-Key.
  failureReason  String?
  createdAt      DateTime @default(now())
}

PORT=4000
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite
# Separate database used only by e2e tests (migrated + seeded in beforeAll)
DATABASE_URL_TEST=postgresql://brewlite:brewlite@localhost:5432/brewlite_test
# Required when NODE_ENV=production (startup fails without it). Use a long random value.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
# Enables PATCH /api/orders/:id/status when set. Empty or unset keeps it disabled (404). Use a long random value.
STAFF_API_KEY=
